    Serial.println(
        response
    );

    http.end();

    return (
        httpCode >= 200 &&
        httpCode < 300
    );
}

// =====================================================
// SEND SMS
// =====================================================

void sendSMS(
    String phone,
    String message
)
{
    if (
        phone.length() == 0
    )
    {
        return;
    }

    Serial.print(
        "Sending SMS to: "
    );

    Serial.println(
        phone
    );

    gsmSerial.println(
        "AT"
    );

    delay(500);

    gsmSerial.println(
        "AT+CMGF=1"
    );

    delay(500);

    gsmSerial.print(
        "AT+CMGS=\""
    );

    gsmSerial.print(
        phone
    );

    gsmSerial.println(
        "\""
    );

    delay(1000);

    gsmSerial.print(
        message
    );

    delay(500);

    gsmSerial.write(
        26
    );

    delay(3000);

    Serial.println(
        "SMS sent"
    );
}

// =====================================================
// MISSED MEDICINE SMS
// =====================================================

void sendMissedMedicineSMS()
{
    String message =
        "ALERT: Medicine was not taken. "
        "Please check the tablet dispenser.";

    for (
        int i = 0;
        i < caregiverCount;
        i++
    )
    {
        if (
            caregivers[i].enabled &&
            caregivers[i].phoneNumber.length() > 0
        )
        {
            sendSMS(
                caregivers[i].phoneNumber,
                message
            );

            delay(1000);
        }
    }
}

// =====================================================
// PREPARE SELECTED BOXES
// =====================================================

void prepareSelectedBoxes(
    Schedule &schedule
)
{
    selectedBoxCount = 0;

    for (
        int i = 0;
        i < MAX_BOXES;
        i++
    )
    {
        currentSelectedBoxes[i] =
            false;
    }

    // ALWAYS scan Box 1 -> Box 6
    for (
        int boxNumber = 1;
        boxNumber <= MAX_BOXES;
        boxNumber++
    )
    {
        if (
            schedule.boxes[
                boxNumber - 1
            ]
        )
        {
            currentSelectedBoxes[
                boxNumber - 1
            ] = true;

            selectedBoxNumbers[
                selectedBoxCount
            ] =
                boxNumber;

            selectedBoxCount++;
        }
    }

    Serial.println();
    Serial.println(
        "===== SELECTED BOXES ====="
    );

    Serial.print(
        "Total selected: "
    );

    Serial.println(
        selectedBoxCount
    );

    for (
        int i = 0;
        i < selectedBoxCount;
        i++
    )
    {
        Serial.print(
            "Box "
        );

        Serial.print(
            selectedBoxNumbers[i]
        );

        Serial.print(
            " -> CH"
        );

        Serial.println(
            boxToServoChannel(
                selectedBoxNumbers[i]
            )
        );
    }
}

// =====================================================
// START DISPENSING
// =====================================================

void startDispensing(
    Schedule &schedule,
    DateTime now
)
{
    prepareSelectedBoxes(
        schedule
    );

    if (
        selectedBoxCount == 0
    )
    {
        Serial.println(
            "No boxes assigned."
        );

        return;
    }

    currentScheduleId =
        schedule.id;

    currentReminderTimeout =
        schedule.reminderTimeout;

    openingIndex = 0;
    closingIndex = 0;

    medicineEventDispensedLogged =
        false;

    medicineEventMissedLogged =
        false;

    medicineEventTakenLogged =
        false;

    lastTriggeredYear =
        now.year();

    lastTriggeredMonth =
        now.month();

    lastTriggeredDay =
        now.day();

    lastTriggeredScheduleId =
        schedule.id;

    // =================================================
    // ALARM
    // =================================================

    digitalWrite(
        RED_LED,
        HIGH
    );

    digitalWrite(
        GREEN_LED,
        LOW
    );

    digitalWrite(
        BUZZER,
        HIGH
    );

    lcdMessage(
        "MEDICINE TIME",
        schedule.scheduleType
    );

    Serial.println();
    Serial.println(
        "================================"
    );

    Serial.println(
        "MEDICINE DISPENSING STARTED"
    );

    Serial.print(
        "Schedule: "
    );

    Serial.println(
        schedule.scheduleType
    );

    Serial.print(
        "Schedule ID: "
    );

    Serial.println(
        schedule.id
    );

    Serial.print(
        "Selected boxes: "
    );

    Serial.println(
        selectedBoxCount
    );

    for (
        int i = 0;
        i < selectedBoxCount;
        i++
    )
    {
        Serial.print(
            "Box "
        );

        Serial.print(
            selectedBoxNumbers[i]
        );

        Serial.print(
            " -> CH"
        );

        Serial.println(
            boxToServoChannel(
                selectedBoxNumbers[i]
            )
        );
    }

    // =================================================
    // LOG DISPENSED
    // =================================================

    if (
        logMedicineEvent(
            "dispensed"
        )
    )
    {
        medicineEventDispensedLogged =
            true;
    }

    // =================================================
    // OPEN FIRST BOX
    // =================================================

    dispenseState =
        DISPENSE_OPENING;

    dispenseTimer =
        millis();

    int firstBox =
        selectedBoxNumbers[
            openingIndex
        ];

    Serial.print(
        "Opening Box "
    );

    Serial.print(
        firstBox
    );

    Serial.print(
        " -> CH"
    );

    Serial.println(
        boxToServoChannel(
            firstBox
        )
    );

    setServoAngleByBox(
        firstBox,
        SERVO_OPEN_ANGLE
    );

    openingIndex++;
}

// =====================================================
// PROCESS DISPENSING
// =====================================================

void processDispensing()
{
    unsigned long nowMillis =
        millis();

    // =================================================
    // OPENING
    // =================================================

    if (
        dispenseState ==
        DISPENSE_OPENING
    )
    {
        if (
            openingIndex <
            selectedBoxCount
        )
        {
            if (
                nowMillis -
                dispenseTimer >=
                SERVO_OPEN_DELAY
            )
            {
                int boxNumber =
                    selectedBoxNumbers[
                        openingIndex
                    ];

                Serial.print(
                    "Opening Box "
                );

                Serial.print(
                    boxNumber
                );

                Serial.print(
                    " -> CH"
                );

                Serial.println(
                    boxToServoChannel(
                        boxNumber
                    )
                );

                setServoAngleByBox(
                    boxNumber,
                    SERVO_OPEN_ANGLE
                );

                openingIndex++;

                dispenseTimer =
                    nowMillis;
            }
        }
        else
        {
            // All selected boxes are open
            dispenseState =
                DISPENSE_ALL_OPEN;

            dispenseTimer =
                nowMillis;

            Serial.println();
            Serial.println(
                "ALL SELECTED BOXES OPEN"
            );

            Serial.println(
                "Waiting 10 seconds..."
            );
        }
    }

    // =================================================
    // ALL OPEN
    // =================================================

    else if (
        dispenseState ==
        DISPENSE_ALL_OPEN
    )
    {
        if (
            nowMillis -
            dispenseTimer >=
            ALL_OPEN_TIME
        )
        {
            Serial.println();
            Serial.println(
                "10 seconds completed."
            );

            Serial.println(
                "Starting closing sequence..."
            );

            closingIndex = 0;

            dispenseState =
                DISPENSE_CLOSING;

            dispenseTimer =
                nowMillis;

            int boxNumber =
                selectedBoxNumbers[
                    closingIndex
                ];

            Serial.print(
                "Closing Box "
            );

            Serial.print(
                boxNumber
            );

            Serial.print(
                " -> CH"
            );

            Serial.println(
                boxToServoChannel(
                    boxNumber
                )
            );

            setServoAngleByBox(
                boxNumber,
                SERVO_CLOSED_ANGLE
            );

            closingIndex++;
        }
    }

    // =================================================
    // CLOSING
    // =================================================

    else if (
        dispenseState ==
        DISPENSE_CLOSING
    )
    {
        if (
            closingIndex <
            selectedBoxCount
        )
        {
            if (
                nowMillis -
                dispenseTimer >=
                SERVO_CLOSE_DELAY
            )
            {
                int boxNumber =
                    selectedBoxNumbers[
                        closingIndex
                    ];

                Serial.print(
                    "Closing Box "
                );

                Serial.print(
                    boxNumber
                );

                Serial.print(
                    " -> CH"
                );

                Serial.println(
                    boxToServoChannel(
                        boxNumber
                    )
                );

                setServoAngleByBox(
                    boxNumber,
                    SERVO_CLOSED_ANGLE
                );

                closingIndex++;

                dispenseTimer =
                    nowMillis;
            }
        }
        else
        {
            Serial.println();
            Serial.println(
                "ALL SELECTED BOXES CLOSED"
            );

            Serial.println(
                "Waiting for TAKEN button..."
            );

            dispenseState =
                DISPENSE_WAITING_TAKEN;

            waitingTakenStart =
                millis();

            lcdMessage(
                "TAKE MEDICINE",
                "Press TAKEN"
            );
        }
    }
}

// =====================================================
// CHECK SCHEDULES
// =====================================================

void checkSchedules()
{
    if (
        dispenseState !=
        DISPENSE_IDLE
    )
    {
        return;
    }

    DateTime now =
        rtc.now();

    for (
        int i = 0;
        i < scheduleCount;
        i++
    )
    {
        Schedule &s =
            schedules[i];

        if (
            !s.enabled
        )
        {
            continue;
        }

        if (
            s.hour !=
            now.hour()
        )
        {
            continue;
        }

        if (
            s.minute !=
            now.minute()
        )
        {
            continue;
        }

        if (
            lastTriggeredYear ==
                now.year() &&
            lastTriggeredMonth ==
                now.month() &&
            lastTriggeredDay ==
                now.day() &&
            lastTriggeredScheduleId ==
                s.id
        )
        {
            continue;
        }

        Serial.println();
        Serial.println(
            "********************************"
        );

        Serial.println(
            "MEDICINE TIME MATCHED"
        );

        Serial.print(
            "Schedule: "
        );

        Serial.println(
            s.scheduleType
        );

        Serial.print(
            "Time: "
        );

        Serial.print(
            s.hour
        );

        Serial.print(":");

        Serial.println(
            s.minute
        );

        startDispensing(
            s,
            now
        );

        break;
    }
}

// =====================================================
// TAKEN BUTTON
// =====================================================

void checkTakenButton()
{
    if (
        dispenseState !=
        DISPENSE_WAITING_TAKEN
    )
    {
        return;
    }

    if (
        digitalRead(
            TAKEN_BUTTON
        ) == LOW
    )
    {
        delay(50);

        if (
            digitalRead(
                TAKEN_BUTTON
            ) != LOW
        )
        {
            return;
        }

        Serial.println();
        Serial.println(
            "********************************"
        );

        Serial.println(
            "TABLET TAKEN"
        );

        Serial.println(
            "********************************"
        );

        // =================================================
        // BUZZER OFF
        // =================================================

        digitalWrite(
            BUZZER,
            LOW
        );

        // =================================================
        // RED OFF
        // =================================================

        digitalWrite(
            RED_LED,
            LOW
        );

        // =================================================
        // GREEN ON
        // =================================================

        digitalWrite(
            GREEN_LED,
            HIGH
        );

        lcdMessage(
            "TABLET TAKEN",
            "CONFIRMED"
        );

        // =================================================
        // LOG TAKEN
        // =================================================

        if (
            !medicineEventTakenLogged
        )
        {
            if (
                logMedicineEvent(
                    "taken"
                )
            )
            {
                medicineEventTakenLogged =
                    true;
            }
        }

        delay(3000);

        digitalWrite(
            GREEN_LED,
            LOW
        );

        currentScheduleId =
            -1;

        selectedBoxCount =
            0;

        dispenseState =
            DISPENSE_IDLE;

        lcdMessage(
            "SYSTEM READY",
            "WAITING..."
        );
    }
}

// =====================================================
// MEDICINE TIMEOUT
// =====================================================

void checkMedicineTimeout()
{
    if (
        dispenseState !=
        DISPENSE_WAITING_TAKEN
    )
    {
        return;
    }

    if (
        currentScheduleId <= 0
    )
    {
        return;
    }

    unsigned long timeoutMillis =
        (unsigned long)
        currentReminderTimeout *
        60UL *
        1000UL;

    if (
        millis() -
        waitingTakenStart >=
        timeoutMillis
    )
    {
        Serial.println();
        Serial.println(
            "********************************"
        );

        Serial.println(
            "MEDICINE MISSED"
        );

        Serial.println(
            "********************************"
        );

        // =================================================
        // LOG MISSED
        // =================================================

        if (
            !medicineEventMissedLogged
        )
        {
            if (
                logMedicineEvent(
                    "missed"
                )
            )
            {
                medicineEventMissedLogged =
                    true;
            }
        }

        // =================================================
        // ALARM OFF
        // =================================================

        digitalWrite(
            BUZZER,
            LOW
        );

        digitalWrite(
            RED_LED,
            LOW
        );

        digitalWrite(
            GREEN_LED,
            LOW
        );

        lcdMessage(
            "MEDICINE MISSED",
            "SMS ALERT"
        );

        // =================================================
        // SEND SMS
        // =================================================

        sendMissedMedicineSMS();

        delay(2000);

        currentScheduleId =
            -1;

        selectedBoxCount =
            0;

        dispenseState =
            DISPENSE_IDLE;

        lcdMessage(
            "SYSTEM READY",
            "WAITING..."
        );
    }
}

