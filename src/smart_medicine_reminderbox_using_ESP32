// =====================================================
// LOOP
// =====================================================

void loop()
{
    unsigned long currentMillis =
        millis();

    // =================================================
    // WIFI RECONNECT
    // =================================================

    if (
        WiFi.status() !=
        WL_CONNECTED
    )
    {
        if (
            currentMillis -
            lastWifiReconnectMillis >=
            WIFI_RECONNECT_INTERVAL
        )
        {
            lastWifiReconnectMillis =
                currentMillis;

            connectWiFi();
        }
    }

    // =================================================
    // SENSOR READING
    // =================================================

    if (
        currentMillis -
        lastSensorMillis >=
        SENSOR_INTERVAL
    )
    {
        lastSensorMillis =
            currentMillis;

        readSensors();

        displaySensorData();
    }

    // =================================================
    // SETTINGS
    // =================================================

    if (
        currentMillis -
        lastSettingsMillis >=
        SETTINGS_INTERVAL
    )
    {
        lastSettingsMillis =
            currentMillis;

        if (
            dispenseState ==
            DISPENSE_IDLE
        )
        {
            getSettings();
        }
    }

    // =================================================
    // HEALTH UPLOAD
    // =================================================

    if (
        currentMillis -
        lastHealthUploadMillis >=
        HEALTH_UPLOAD_INTERVAL
    )
    {
        lastHealthUploadMillis =
            currentMillis;

        uploadHealthData();
    }

    // =================================================
    // DEVICE STATUS
    // =================================================

    if (
        currentMillis -
        lastDeviceStatusMillis >=
        DEVICE_STATUS_INTERVAL
    )
    {
        lastDeviceStatusMillis =
            currentMillis;

        uploadDeviceStatus();
    }

    // =================================================
    // SCHEDULE
    // =================================================

    checkSchedules();

    // =================================================
    // DISPENSING
    // =================================================

    processDispensing();

    // =================================================
    // TAKEN
    // =================================================

    checkTakenButton();

    // =================================================
    // TIMEOUT
    // =================================================

    checkMedicineTimeout();

    // =================================================
    // GSM SERIAL
    // =================================================

    while (
        gsmSerial.available()
    )
    {
        Serial.write(
            gsmSerial.read()
        );
    }

    delay(5);
}
