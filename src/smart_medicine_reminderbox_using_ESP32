// =====================================================
// PARSE SETTINGS
// =====================================================

bool parseSettings(
    String payload
)
{
    DynamicJsonDocument doc(
        20000
    );

    DeserializationError error =
        deserializeJson(
            doc,
            payload
        );

    if (error)
    {
        Serial.print(
            "JSON Error: "
        );

        Serial.println(
            error.c_str()
        );

        return false;
    }

    if (
        !doc["success"].as<bool>()
    )
    {
        Serial.println(
            "Server returned success=false"
        );

        return false;
    }

    // =================================================
    // BOXES
    // =================================================

    boxCount = 0;

    JsonArray boxArray =
        doc["boxes"].as<JsonArray>();

    for (
        JsonObject obj :
        boxArray
    )
    {
        if (
            boxCount >= MAX_BOXES
        )
        {
            break;
        }

        boxes[boxCount].id =
            obj["id"] | 0;

        boxes[boxCount].boxNumber =
            obj["box_number"] | 0;

        boxes[boxCount].tabletName =
            obj["tablet_name"] |
            "Tablet";

        boxes[boxCount].status =
            obj["status"] | 0;

        boxCount++;
    }

    Serial.println();
    Serial.println(
        "===== BOX CONFIGURATION ====="
    );

    for (
        int i = 0;
        i < boxCount;
        i++
    )
    {
        Serial.print(
            "Box "
        );

        Serial.print(
            boxes[i].boxNumber
        );

        Serial.print(
            " | DB ID: "
        );

        Serial.print(
            boxes[i].id
        );

        Serial.print(
            " | "
        );

        Serial.println(
            boxes[i].tabletName
        );
    }

    // =================================================
    // SCHEDULES
    // =================================================

    scheduleCount = 0;

    JsonArray scheduleArray =
        doc["schedules"].as<JsonArray>();

    for (
        JsonObject obj :
        scheduleArray
    )
    {
        if (
            scheduleCount >=
            MAX_SCHEDULES
        )
        {
            break;
        }

        Schedule &s =
            schedules[
                scheduleCount
            ];

        s.id =
            obj["id"] | 0;

        s.scheduleType =
            obj["schedule_type"] |
            "";

        String time =
            obj["medicine_time"] |
            "00:00:00";

        int firstColon =
            time.indexOf(":");

        int secondColon =
            time.indexOf(
                ":",
                firstColon + 1
            );

        if (
            firstColon >= 0
        )
        {
            s.hour =
                time.substring(
                    0,
                    firstColon
                ).toInt();

            if (
                secondColon >= 0
            )
            {
                s.minute =
                    time.substring(
                        firstColon + 1,
                        secondColon
                    ).toInt();
            }
            else
            {
                s.minute =
                    time.substring(
                        firstColon + 1
                    ).toInt();
            }
        }
        else
        {
            s.hour = 0;
            s.minute = 0;
        }

        s.enabled =
            obj["enabled"] | 0;

        s.reminderTimeout =
            obj["reminder_timeout"] | 5;

        clearScheduleBoxes(
            s
        );

        JsonArray scheduleBoxes =
            obj["boxes"].as<JsonArray>();

        for (
            JsonObject boxObj :
            scheduleBoxes
        )
        {
            int boxNumber =
                boxObj["box_number"] | 0;

            if (
                boxNumber >= 1 &&
                boxNumber <= MAX_BOXES
            )
            {
                s.boxes[
                    boxNumber - 1
                ] = true;
            }
        }

        scheduleCount++;
    }

    // =================================================
    // PRINT SCHEDULES
    // =================================================

    Serial.println();
    Serial.println(
        "===== SCHEDULES ====="
    );

    for (
        int i = 0;
        i < scheduleCount;
        i++
    )
    {
        Schedule &s =
            schedules[i];

        Serial.print(
            "Schedule "
        );

        Serial.print(
            s.id
        );

        Serial.print(
            " | "
        );

        Serial.print(
            s.scheduleType
        );

        Serial.print(
            " | "
        );

        if (s.hour < 10)
            Serial.print("0");

        Serial.print(
            s.hour
        );

        Serial.print(":");

        if (s.minute < 10)
            Serial.print("0");

        Serial.print(
            s.minute
        );

        Serial.print(
            " | Boxes: "
        );

        bool first = true;

        for (
            int b = 0;
            b < MAX_BOXES;
            b++
        )
        {
            if (
                s.boxes[b]
            )
            {
                if (!first)
                {
                    Serial.print(
                        ","
                    );
                }

                Serial.print(
                    b + 1
                );

                first = false;
            }
        }

        Serial.println();
    }

    // =================================================
    // CAREGIVERS
    // =================================================

    caregiverCount = 0;

    JsonArray caregiverArray =
        doc["caregivers"].as<JsonArray>();

    for (
        JsonObject obj :
        caregiverArray
    )
    {
        if (
            caregiverCount >=
            MAX_CAREGIVERS
        )
        {
            break;
        }

        caregivers[
            caregiverCount
        ].id =
            obj["id"] | 0;

        caregivers[
            caregiverCount
        ].phoneNumber =
            obj["phone_number"] |
            "";

        caregivers[
            caregiverCount
        ].caregiverName =
            obj["caregiver_name"] |
            "Caregiver";

        caregivers[
            caregiverCount
        ].enabled =
            obj["enabled"] | 0;

        caregiverCount++;
    }

    Serial.println();
    Serial.print(
        "Caregivers loaded: "
    );

    Serial.println(
        caregiverCount
    );

    return true;
}

// =====================================================
// GET SETTINGS
// =====================================================

bool getSettings()
{
    if (
        WiFi.status() !=
        WL_CONNECTED
    )
    {
        return false;
    }

    HTTPClient http;

    http.begin(
        SETTINGS_URL
    );

    http.setTimeout(
        10000
    );

    int httpCode =
        http.GET();

    if (
        httpCode !=
        HTTP_CODE_OK
    )
    {
        Serial.print(
            "Settings HTTP Error: "
        );

        Serial.println(
            httpCode
        );

        http.end();

        return false;
    }

    String payload =
        http.getString();

    http.end();

    Serial.println();
    Serial.println(
        "Settings received"
    );

    return parseSettings(
        payload
    );
}

// =====================================================
// WIFI
// =====================================================

void connectWiFi()
{
    if (
        WiFi.status() ==
        WL_CONNECTED
    )
    {
        return;
    }

    Serial.println();
    Serial.println(
        "Connecting WiFi..."
    );

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );

    unsigned long start =
        millis();

    while (
        WiFi.status() !=
        WL_CONNECTED &&
        millis() - start < 10000
    )
    {
        delay(500);
        Serial.print(".");
    }

    Serial.println();

    if (
        WiFi.status() ==
        WL_CONNECTED
    )
    {
        Serial.println(
            "WiFi connected"
        );

        Serial.print(
            "IP: "
        );

        Serial.println(
            WiFi.localIP()
        );
    }
    else
    {
        Serial.println(
            "WiFi connection failed"
        );
    }
}

// =====================================================
// READ SENSORS
// =====================================================

void readSensors()
{
    // =================================================
    // TEMPERATURE
    // =================================================

    tempSensor.requestTemperatures();

    float temp =
        tempSensor.getTempCByIndex(0);

    if (
        temp !=
        DEVICE_DISCONNECTED_C
    )
    {
        temperatureC =
            temp;
    }

    // =================================================
    // MAX30102
    // =================================================

    if (
        max30102Available
    )
    {
        int32_t spo2 = 0;
        int8_t spo2Valid = 0;

        int32_t heartRate = 0;
        int8_t heartRateValid = 0;

        particleSensor
            .heartrateAndOxygenSaturation(
                &spo2,
                &spo2Valid,
                &heartRate,
                &heartRateValid
            );

        spo2Value =
            spo2;

        spo2ValidValue =
            spo2Valid;

        heartRateValue =
            heartRate;

        heartRateValidValue =
            heartRateValid;
    }
}

// =====================================================
// LCD SENSOR DISPLAY
// =====================================================

void displaySensorData()
{
    if (
        dispenseState !=
        DISPENSE_IDLE
    )
    {
        return;
    }

    DateTime now =
        rtc.now();

    if (
        millis() -
        lastLCDPageMillis >=
        LCD_PAGE_INTERVAL
    )
    {
        lastLCDPageMillis =
            millis();

        lcdPage++;

        if (
            lcdPage > 2
        )
        {
            lcdPage = 0;
        }
    }

    lcd.clear();

    // =================================================
    // TIME
    // =================================================

    lcd.setCursor(
        0,
        0
    );

    lcd.print(
        "TIME "
    );

    if (
        now.hour() < 10
    )
        lcd.print("0");

    lcd.print(
        now.hour()
    );

    lcd.print(":");

    if (
        now.minute() < 10
    )
        lcd.print("0");

    lcd.print(
        now.minute()
    );

    lcd.print(":");

    if (
        now.second() < 10
    )
        lcd.print("0");

    lcd.print(
        now.second()
    );

    // =================================================
    // PAGE 0
    // TEMPERATURE + HR
    // =================================================

    if (
        lcdPage == 0
    )
    {
        lcd.setCursor(
            0,
            1
        );

        lcd.print(
            "T:"
        );

        lcd.print(
            temperatureC,
            1
        );

        lcd.print(
            "C HR:"
        );

        if (
            heartRateValidValue
        )
        {
            lcd.print(
                heartRateValue
            );
        }
        else
        {
            lcd.print(
                "--"
            );
        }
    }

    // =================================================
    // PAGE 1
    // SPO2
    // =================================================

    else if (
        lcdPage == 1
    )
    {
        lcd.setCursor(
            0,
            1
        );

        lcd.print(
            "SpO2:"
        );

        if (
            spo2ValidValue
        )
        {
            lcd.print(
                spo2Value
            );

            lcd.print(
                "%"
            );
        }
        else
        {
            lcd.print(
                "--"
            );
        }
    }

    // =================================================
    // PAGE 2
    // BOXES
    // =================================================

    else
    {
        lcd.setCursor(
            0,
            1
        );

        lcd.print(
            "BOXES:"
        );

        for (
            int i = 0;
            i < MAX_BOXES;
            i++
        )
        {
            if (
                i > 0
            )
            {
                lcd.print(
                    " "
                );
            }

            lcd.print(
                i + 1
            );
        }
    }
}

