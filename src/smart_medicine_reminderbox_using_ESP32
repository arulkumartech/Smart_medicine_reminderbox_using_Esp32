// =====================================================
// BOX -> SERVO CHANNEL
// =====================================================
//
// IMPORTANT:
//
// Box 1 -> CH0
// Box 2 -> CH1
// Box 3 -> CH2
// Box 4 -> CH3
// Box 5 -> CH4
// Box 6 -> CH5
//
// Your standalone servo test confirmed
// the physical servos are connected to CH0-CH5.
// =====================================================

int boxToServoChannel(
    int boxNumber
)
{
    if (
        boxNumber < 1 ||
        boxNumber > MAX_BOXES
    )
    {
        return -1;
    }

    return boxNumber - 1;
}

// =====================================================
// SET SERVO BY PCA9685 CHANNEL
// =====================================================

void setServoAngle(
    uint8_t channel,
    int angle
)
{
    if (channel > 15)
    {
        return;
    }

    angle = constrain(
        angle,
        0,
        180
    );

    int pulse =
        map(
            angle,
            0,
            180,
            SERVOMIN,
            SERVOMAX
        );

    pwm.setPWM(
        channel,
        0,
        pulse
    );

    Serial.print("CH");
    Serial.print(channel);
    Serial.print(" -> ");
    Serial.print(angle);
    Serial.println(" degree");
}

// =====================================================
// SET SERVO BY BOX NUMBER
// =====================================================

void setServoAngleByBox(
    int boxNumber,
    int angle
)
{
    int channel =
        boxToServoChannel(
            boxNumber
        );

    if (channel < 0)
    {
        Serial.print(
            "Invalid Box: "
        );

        Serial.println(
            boxNumber
        );

        return;
    }

    Serial.print(
        "Box "
    );

    Serial.print(
        boxNumber
    );

    Serial.print(
        " -> CH"
    );

    Serial.print(
        channel
    );

    Serial.print(
        " -> "
    );

    Serial.print(
        angle
    );

    Serial.println(
        " degree"
    );

    setServoAngle(
        channel,
        angle
    );
}

