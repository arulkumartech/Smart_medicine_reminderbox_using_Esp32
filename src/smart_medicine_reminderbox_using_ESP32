// =====================================================
// ADD BOX DATABASE IDs
// =====================================================

void addBoxIdsToJson(
    DynamicJsonDocument &doc
)
{
    JsonArray array =
        doc["box_ids"]
            .to<JsonArray>();

    for (
        int i = 0;
        i < selectedBoxCount;
        i++
    )
    {
        int boxNumber =
            selectedBoxNumbers[i];

        int index =
            findBoxIndex(
                boxNumber
            );

        if (
            index >= 0
        )
        {
            array.add(
                boxes[index].id
            );
        }
    }
}

